{:glfw/window {:title                          "Epiktetos"
               :width                          800
               :height                         600
               :display                        :windowed
               :mode/cursor                    :cursor/normal
               :mode/sticky-keys               false
               :window/visible                 true
               :window/resizable               true
               :hint.window/samples            8
               :hint.window/srgb-capable       true
               :hint.context/version.maj       4
               :hint.context/version.min       6
               :hint.context/gl.profile        :gl.profile/core
               :hint.context/gl.forward-compat true
               :hint.context/gl.debug          true}

 :gl/engine {:context #ig/ref :glfw/window
             :hot-reload ["resources/shaders/"]
             :error-pause {:enabled? true}}}
